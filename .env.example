# Database (Postgres — e.g. Supabase connection string)
DATABASE_URL="postgresql://user:password@host:5432/tolaby?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/tolaby?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# File storage (Supabase Storage or S3-compatible)
STORAGE_URL="https://your-project.supabase.co"
STORAGE_BUCKET_PROPERTIES="property-images"
STORAGE_BUCKET_DOCS="verification-docs"
STORAGE_SERVICE_KEY="replace-with-service-role-key"

# Payments (mock provider by default — see src/lib/payments.ts)
PAYMENT_PROVIDER="mock"
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
